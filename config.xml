<?xml version='1.0' encoding='utf-8'?>
<widget id="com.balloonpopmaths.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets">
    <name>Pop Balon Ajaib</name>
    <description>Game matematika interaktif untuk anak SD - Belajar sambil bermain!</description>
    <author email="ilkom@ummetro.ac.id">Universitas Muhammadiyah Metro</author>
    <content src="index.html" />
    <platform name="android">
        <icon src="www/assets/images/icon.png" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="www/assets/images/splash.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#ffffff" />
    </platform>
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="0xffffffff" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="mailto:*" />
    <allow-navigation href="https://*.firebaseapp.com/*" />
    <allow-navigation href="https://*.googleapis.com/*" />
    <allow-navigation href="https://*.gstatic.com/*" />
</widget>